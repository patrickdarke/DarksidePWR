// Copy to secrets.h (gitignored) and fill in. Never commit real credentials.
#pragma once

// Compile-time fallback only — the on-device Wi-Fi setup screen (gear
// button) stores credentials in NVS, which wins over these at boot.
#define WIFI_SSID "YOUR_TRUCK_SSID"
#define WIFI_PASS "YOUR_WIFI_PASSWORD"

// Victron GX addressing: mDNS name first, pinned address as fallback.
// First-boot default only — the setup screen's GX ADDRESS field (NVS)
// overrides it at runtime and skips the fallback for custom targets.
#define GX_MDNS_HOST "venus"          // resolves venus.local on the truck LAN
#define GX_FALLBACK_IP "10.20.30.239"

// Modbus unit id of the Orion XS (com.victronenergy.alternator service) —
// installation-specific; found by sweeping unitid2di.csv units against
// register 4100. 239 on the Darkside.Overland Ekrano.
#define GX_ALT_UNIT 239

// Modbus unit id of the MultiPlus (com.victronenergy.vebus service) — used
// by the CONTROL page for mode + shore current limit. Type 'V' into the
// serial port to sweep for it on a new installation.
#define GX_VEBUS_UNIT 227

// Temperature sensors (any com.victronenergy.temperature service — Ruuvi,
// wired probes, ...): Modbus unit id = the sensor's device instance (VRM
// device list shows it, e.g. "Temperature sensor [22]"). Labels align by
// position. List length is free — polling/display size themselves to these
// lists (labels must match length; the footer line fits about three).
#define GX_TEMP_UNITS {22, 23, 25}
#define GX_TEMP_LABELS {"OUT", "FRIDGE", "IN"}

// Tank senders (any com.victronenergy.tank service — Mopeka, resistive,
// ...; unit id = device instance). Same rules as the temperature lists.
#define GX_TANK_UNITS {23, 24, 25}
#define GX_TANK_LABELS {"BLANTON", "ELIJAH", "PAPPY"}

// Temperature display unit: 1 = Fahrenheit, 0 = Celsius (temps line and
// telemetry; the on-screen values show a bare degree sign either way).
// First-boot default — the setup screen's UNITS button overrides via NVS.
#define TEMPS_IN_F 1

// Display title (upper left of the power screen). Leave "" to auto-pull the
// GX system name (VRM installation name; names past 16 chars arrive
// truncated — Modbus reg 5700 is string[8]). Set a string to fix it.
#define UI_TITLE ""
